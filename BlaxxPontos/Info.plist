<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fonte de display da marca (Space Grotesk, TTF variável — instância
	     default Light; PostScript "SpaceGrotesk-Light"). iOS/visionOS usam
	     UIAppFonts; macOS nativo usa ATSApplicationFontsPath. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
		<string>Archivo-Variable.ttf</string>
		<string>SpaceMono-Regular.ttf</string>
		<string>SpaceMono-Bold.ttf</string>
	</array>
	<!-- Tela de lançamento (24/10/2026): fundo tinta #0A0B0E + wordmark oficial "BlaXx" (vetor, 155 × 30 pt),
	     idêntica à BXAbertura que vem logo depois. Antes era a tela gerada vazia (branca), que piscava
	     antes da abertura preta. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>BXAberturaFundo</string>
		<key>UIImageName</key>
		<string>BXAberturaMarca</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- App Store (23/10/2026): idioma principal pt-BR (diálogos do sistema em português). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-BR</string>
	</array>
	<!-- Criptografia: só HTTPS/TLS do sistema e CryptoKit (hash do nonce/PKCE) → isento
	     (sem pergunta de exportação a cada envio ao App Store Connect). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Face ID: usado para confirmar transações financeiras (envio/resgate
	     de pontos). Sem essa string o LocalAuthentication falha com -6. -->
	<key>NSFaceIDUsageDescription</key>
	<string>A BlaXx usa o Face ID para confirmar que é você antes de enviar ou resgatar pontos.</string>
	<!-- Câmera: o Enviar pontos (G3) lê o QR Code de um Cartão BlaXx. -->
	<key>NSCameraUsageDescription</key>
	<string>A BlaXx usa a câmera só para ler o QR Code de um Cartão BlaXx na hora de enviar pontos. Nenhuma imagem é guardada.</string>
	<!-- Fotos (só gravação): o menu de compartilhar dos comprovantes oferece "Salvar imagem";
	     sem esta chave o iOS encerra o app ao tocar nessa opção. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>A BlaXx salva nas suas Fotos a imagem do comprovante que você pediu para guardar.</string>
	<!--
	  Google Sign-In: custom URL scheme reverso do Client ID iOS.
	  Client ID original: 105341431878-3msc2p3tjk3p5ro6i34d0b0qks3nf9dj.apps.googleusercontent.com
	  Scheme reverso:     com.googleusercontent.apps.105341431878-3msc2p3tjk3p5ro6i34d0b0qks3nf9dj
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blaxx.BlaxxPontos.googleoauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.105341431878-3msc2p3tjk3p5ro6i34d0b0qks3nf9dj</string>
			</array>
		</dict>
		<!--
		  Esquema custom do app para deep links de recuperação de senha:
		  blaxxpontos://redefinir-senha?token=…
		  Capturado em BlaxxPontosApp.onOpenURL → ResetPasswordView.
		-->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blaxx.BlaxxPontos.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blaxxpontos</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
